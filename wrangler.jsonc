{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siperlu",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "siperlu-db",
      "database_id": "4870280b-cc3f-4214-830e-ccb7cbc2b8fb",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "siperlu-files"
    }
  ],
  "observability": {
    "enabled": true
  }
}
